{
  "manifest_version": 3,
  "name": "WebMind AI",
  "version": "1.0.0",
  "description": "Your AI companion for understanding any webpage.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}

